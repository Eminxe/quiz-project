{
  "name": "ems-math",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "infra:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d",
    "db:generate": "pnpm --filter @ems/db generate",
    "db:migrate": "pnpm --filter @ems/db migrate",
    "db:seed": "pnpm --filter @ems/db seed",
    "dev:api": "pnpm --filter @ems/api dev",
    "dev:worker": "pnpm --filter @ems/worker-generation dev",
    "dev:web": "pnpm --filter @ems/web dev",
    "build:web": "pnpm --filter @ems/web build",
    "test": "node --test tests/*.test.js"
  }
}
